# Web server and local memory file.
PORT=8080
MEMORY_FILE=data/memory.json

# Ollama server and local model selection.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MIN_FREE_GB=4

# Per-request model and network resource limits.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=192
OLLAMA_NUM_THREAD=2
MAX_CLIENTS=8
MAX_INPUT_BYTES=4096
MAX_CONTEXT_BYTES=2048

# Persistent memory limits.
MEMORY_MAX_BYTES=5242880
MEMORY_MAX_ITEMS=1000
MEMORY_MAX_ENTRY_BYTES=8192